# Copy to .env and fill in. Only OPENROUTER_API_KEY is required, and only
# when extracting a fixture that is not already in data/extraction_cache.json
# (the notebook runs from that cache without a key).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
